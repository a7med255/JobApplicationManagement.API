  },
  "Jwt": {
    "Key": "GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
  },
  "Cors": {
    "AllowedOrigins": ["https://YOUR_CAREERLY_DOMAIN"]
  },

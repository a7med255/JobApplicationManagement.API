  "Email": {
    "Enabled": true,
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "UseSsl": false,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromAddress": "no-reply@YOUR_DOMAIN",
    "FromName": "Careerly",
    "FrontendBaseUrl": "https://YOUR_CAREERLY_DOMAIN"
  },
  "DataProtection": {

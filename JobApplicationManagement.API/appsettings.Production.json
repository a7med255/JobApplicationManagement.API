{
  "Jwt": {
    "Issuer": "Careerly",
    "Audience": "Careerly.Web",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Email": {
    "Enabled": true,
    "Port": 587,
    "UseSsl": false,
    "FromName": "Careerly"
  },
  "DataProtection": {
    "KeysPath": "App_Data/DataProtectionKeys"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
